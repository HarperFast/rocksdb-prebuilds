 namespace ROCKSDB_NAMESPACE {

+class BlobDirFsyncTrackingFileSystem : public FileSystemWrapper {
+ public:
+  BlobDirFsyncTrackingFileSystem(std::shared_ptr<FileSystem> target,
+                                 std::string blob_dir)
+      : FileSystemWrapper(std::move(target)), blob_dir_(std::move(blob_dir)) {}
+
+  const char* Name() const override {
+    return "BlobDirFsyncTrackingFileSystem";
+  }
+
+  IOStatus NewDirectory(const std::string& name, const IOOptions& options,
+                        std::unique_ptr<FSDirectory>* result,
+                        IODebugContext* dbg) override {
+    IOStatus s = FileSystemWrapper::NewDirectory(name, options, result, dbg);
+    if (s.ok()) {
+      const bool is_blob_dir =
+          NormalizePath(name) == NormalizePath(blob_dir_);
+      if (is_blob_dir) {
+        blob_directory_opens_.fetch_add(1, std::memory_order_acq_rel);
+      }
+      *result = std::make_unique<TrackingDirectory>(
+          std::move(*result), this, is_blob_dir);
+    }
+    return s;
+  }
+
+  void Reset() {
+    blob_dir_fsyncs_.store(0, std::memory_order_release);
+    blob_directory_opens_.store(0, std::memory_order_release);
+  }
+
+  int BlobDirFsyncs() const {
+    return blob_dir_fsyncs_.load(std::memory_order_acquire);
+  }
+
+  int BlobDirectoryOpens() const {
+    return blob_directory_opens_.load(std::memory_order_acquire);
+  }
+
+ private:
+  class TrackingDirectory : public FSDirectoryWrapper {
+   public:
+    TrackingDirectory(std::unique_ptr<FSDirectory>&& target,
+                      BlobDirFsyncTrackingFileSystem* fs, bool is_blob_dir)
+        : FSDirectoryWrapper(std::move(target)),
+          fs_(fs),
+          is_blob_dir_(is_blob_dir) {}
+
+    IOStatus FsyncWithDirOptions(
+        const IOOptions& options, IODebugContext* dbg,
+        const DirFsyncOptions& dir_options) override {
+      IOStatus s = FSDirectoryWrapper::FsyncWithDirOptions(options, dbg,
+                                                           dir_options);
+      if (s.ok() && is_blob_dir_) {
+        fs_->blob_dir_fsyncs_.fetch_add(1, std::memory_order_acq_rel);
+      }
+      return s;
+    }
+
+   private:
+    BlobDirFsyncTrackingFileSystem* fs_;
+    bool is_blob_dir_;
+  };
+
+  const std::string blob_dir_;
+  std::atomic<int> blob_dir_fsyncs_{0};
+  std::atomic<int> blob_directory_opens_{0};
+};
