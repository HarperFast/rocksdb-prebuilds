+TEST_F(DBFlushTest, BlobDirIsFsyncedForOrdinaryAndAtomicFlush) {
+  const std::string blob_dir = dbname_ + "_blobs";
+  auto tracking_fs = std::make_shared<BlobDirFsyncTrackingFileSystem>(
+      FileSystem::Default(), blob_dir);
+  std::unique_ptr<Env> tracking_env(NewCompositeEnv(tracking_fs));
+
+  for (bool atomic_flush : {false, true}) {
+    for (bool direct_write : {false, true}) {
+      SCOPED_TRACE(atomic_flush ? "atomic flush" : "ordinary flush");
+      SCOPED_TRACE(direct_write ? "direct blob write" : "flush blob write");
+      Options options = CurrentOptions();
+      options.env = tracking_env.get();
+      options.create_if_missing = true;
+      options.atomic_flush = atomic_flush;
+      options.enable_blob_files = true;
+      options.enable_blob_direct_write = direct_write;
+      options.allow_concurrent_memtable_write = false;
+      options.blob_direct_write_partitions = 1;
+      options.min_blob_size = 0;
+      options.blob_dir = blob_dir;
+
+      DestroyAndReopen(options);
+      CreateAndReopenWithCF({"cf1"}, options);
+      EXPECT_GT(tracking_fs->BlobDirectoryOpens(), 0);
+      tracking_fs->Reset();
+
+      ASSERT_OK(Put(0, "default-key", std::string(1024, 'd')));
+      ASSERT_OK(Put(1, "cf-key", std::string(1024, 'c')));
+      ASSERT_OK(Flush({0, 1}));
+      EXPECT_GT(tracking_fs->BlobDirFsyncs(), 0);
+      ASSERT_EQ(std::string(1024, 'd'), Get(0, "default-key"));
+      ASSERT_EQ(std::string(1024, 'c'), Get(1, "cf-key"));
+
+      Close();
+      ReopenWithColumnFamilies({"default", "cf1"}, options);
+      ASSERT_EQ(std::string(1024, 'd'), Get(0, "default-key"));
+      ASSERT_EQ(std::string(1024, 'c'), Get(1, "cf-key"));
+      Close();
+      ASSERT_OK(DestroyDB(dbname_, options));
+    }
+  }
+
