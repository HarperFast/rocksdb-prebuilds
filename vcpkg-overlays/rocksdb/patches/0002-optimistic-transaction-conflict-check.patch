@@ -47,6 +47,9 @@ class OptimisticTransaction : public TransactionBaseImpl {
 
   Status SetName(const TransactionName& name) override;
 
+  // See CheckOptimisticTransactionForConflicts().
+  Status CheckForConflicts() { return CheckTransactionForConflicts(db_->GetRootDB()); }
+
  protected:
   Status TryLock(ColumnFamilyHandle* column_family, const Slice& key,
                  bool read_only, bool exclusive, const bool do_validate = true,
